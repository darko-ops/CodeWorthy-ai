new file mode 100644
index 0000000..4c400b9
--- /dev/null
+++ b/db/migrations/0004_idempotency_keys.sql
@@ -0,0 +1,9 @@
+-- ACME-1287: durable idempotency for checkout. The previous in-memory cache
+-- was per-process and only written after payment capture, so in-flight and
+-- cross-replica retries created duplicate orders. Additive and backwards
+-- compatible: the previous release never touches this table.
+CREATE TABLE idempotency_keys (
+    key text PRIMARY KEY,
+    order_id uuid REFERENCES orders (id),
+    created_at timestamptz NOT NULL DEFAULT now()
+);
