{
  "name": "codeworthy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeWorthy backend service — Steward GitHub App webhook handler + audit spine, and the seed of the site's Phase 2 API. Modular monolith: src/steward and src/api, shared Postgres, separate schemas.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx db/migrate.ts",
    "anchor": "tsx src/audit/anchor-job.ts",
    "reconcile": "tsx src/audit/reconcile-job.ts",
    "export": "tsx src/evidence/export-job.ts",
    "digest": "tsx src/digest/digest-job.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1102.0",
    "@types/nodemailer": "^8.0.1",
    "fastify": "^5.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
