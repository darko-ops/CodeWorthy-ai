{
  "name": "codeworthy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeWorthy backend service — Steward GitHub App webhook handler + audit spine, and the seed of the site's Phase 2 API. Modular monolith: src/steward and src/api, shared Postgres, separate schemas.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
