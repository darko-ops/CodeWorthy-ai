# Copy to .env for local dev. The service reads plain env vars (no dotenv loader
# in prod — the platform injects these).
PORT=8080
DATABASE_URL=postgres://user:pass@host:5432/codeworthy

# GitHub App credentials (from the App's settings page). Absent in M1 local dev
# except when exercising live webhooks.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# PEM private key with literal newlines escaped as \n (unescaped at load).
GITHUB_PRIVATE_KEY=

# LLM advise tier (M3) — OFF by default. Nothing calls out unless this is set
# AND the installation opts in. The deterministic tier and gate never call out.
STEWARD_LLM_ENABLED=0

# ── Enforcement spine ──
# Turning protection ON is always a human decision (the consent click on
# /steward/setup, or this flag for an operator-driven install).
STEWARD_AUTO_PROTECT=0
# KEEPING it on is the product. When a rule is weakened, CodeWorthy puts it back
# and records both the weakening and the fix. Set to 0 for report-only
# stewardship (detect and log, correct nothing).
STEWARD_RESTORE_PROTECTION=1
# How often the backstop sweep re-checks every stewarded repo. Webhooks are the
# fast path (seconds); this makes the guarantee independent of any one delivery.
STEWARD_PROTECTION_SWEEP_MINUTES=60
# Run the in-process scheduler (anchor, digest, reconcile, protection sweep).
# Exactly one instance, so a job never double-fires.
STEWARD_SCHEDULER=0

# ── The approver (a SECOND GitHub App, separate credentials on purpose) ──
# The actor that reviews a change must not be the actor that approves it, or the
# approval is the reviewer agreeing with itself. Create it at /steward/approver.
# Unset -> no approver exists, and protection never requires an approving review
# (a required approval nobody can give is an unmergeable repository).
APPROVER_APP_ID=
APPROVER_PRIVATE_KEY=
APPROVER_APP_SLUG=
# 1 = also form an independent second read of the diff. It can only ever
# WITHHOLD approval, never grant one the base rules would have refused.
APPROVER_STRICT=0
