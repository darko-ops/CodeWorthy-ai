# Copy to .env for local dev. The service reads plain env vars (no dotenv loader
# in prod — the platform injects these).
PORT=8080
DATABASE_URL=postgres://user:pass@host:5432/codeworthy

# GitHub App credentials (from the App's settings page). Absent in M1 local dev
# except when exercising live webhooks.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# PEM private key with literal newlines escaped as \n (unescaped at load).
GITHUB_PRIVATE_KEY=

# LLM advise tier (M3) — OFF by default. Nothing calls out unless this is set
# AND the installation opts in. The deterministic tier and gate never call out.
STEWARD_LLM_ENABLED=0
