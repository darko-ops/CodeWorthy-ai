{
  "name": "CodeWorthy Steward",
  "url": "https://codeworthy.ai",
  "hook_attributes": {
    "url": "https://codeworthy-steward.fly.dev/webhook"
  },
  "redirect_url": "https://codeworthy.ai",
  "public": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "checks": "write",
    "administration": "write",
    "issues": "write",
    "metadata": "read"
  },
  "default_events": [
    "push",
    "pull_request",
    "issue_comment",
    "installation_repositories"
  ]
}
